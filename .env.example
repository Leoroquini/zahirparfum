# ZAHIR PARFUMS — variáveis de ambiente
# Copie este arquivo pra `.env.local` e preencha com os IDs reais quando ativar cada serviço.

# Google Analytics 4 (quando você criar a propriedade no GA)
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Meta Pixel (Facebook/Instagram ads)
# ID numérico obtido no Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# URL pública do site (usada em metadados SEO/OG e nos back_urls do checkout)
NEXT_PUBLIC_SITE_URL=https://zahirparfums.com.br
SITE_URL=https://zahirparfums.com.br

# ----------------------------------------------------------------
# Mercado Pago — checkout (ver site/CHECKOUT.md pra setup completo)
# ----------------------------------------------------------------
# Modo: "test" usa sandbox_init_point (não cobra de verdade); "production" cobra.
MERCADOPAGO_MODE=test

# Credenciais. Pegue em: https://www.mercadopago.com.br/developers/panel/app
# > sua aplicação > Credenciais (TEST pra desenvolvimento, PROD pra produção)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# "Assinatura secreta" do webhook (painel MP > sua aplicação > Webhooks).
# Usada pra validar que a notificação veio do MP, não de atacante.
# OBRIGATÓRIA em produção. Sem ela, webhook aceita qualquer request.
MERCADOPAGO_WEBHOOK_SECRET=

# Email pra onde cai notificação de venda (futuro, ainda não cabeado)
PEDIDO_NOTIFICA_EMAIL=
