# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local references (Gemini images + source .md — não versionar)
/informações novas/
/fotos dos perfumes/
/fotos novas/

# backup das fotos antigas (substituídas pelas novas oficiais)
/public/perfumes/_old/

# backup automático do script optimize-images.mjs
/public/_backup_pre_optimize/

# dev server logs locais
.dev.log
zahir-dev*.log
zahir-start*.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
